APP_NAME="SSU Frontend"
ENVIRONMENT=staging

# BASE_URL=http://afia.pageone247.com
# API_PATH=/api
# BACKEND_URL=http://afia.pageone247.com

NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_API_PATH=/api/v1
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Apex/base domain that store subdomains sit under (acme.<base>). Must match the
# backend STOREFRONT_BASE_DOMAIN. Dev: localhost. Prod: your apex (e.g. yoursite.com).
NUXT_PUBLIC_STOREFRONT_BASE_DOMAIN=localhost

NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8000
NUXT_PUBLIC_REVERB_SCHEME=http

STRIPE_LIVE_ENVIRONMENT=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_ACCOUNT=
STRIPE_API_VERSION=
STRIPE_LOCALE=en