{
  "name": "ssu-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "typecheck": "NUXT_BUILD_DIR=.nuxt-typecheck nuxt prepare && vue-tsc --noEmit -p .nuxt-typecheck/tsconfig.app.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "generate": "NUXT_PUBLIC_STATIC_GENERATION=true nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/icon": "^2.2.0",
    "@pinia/nuxt": "^0.11.3",
    "apexcharts": "^7.5.1",
    "chart.js": "^4.5.1",
    "country-state-city": "^3.2.1",
    "i18n-iso-countries": "^7.14.0",
    "isomorphic-dompurify": "^2.16.0",
    "laravel-echo": "^2.3.1",
    "marked": "^14.1.3",
    "motion-v": "^2.3.0",
    "nuxt": "^4.6.1",
    "philippines": "^1.0.0",
    "pusher-js": "^8.4.3",
    "reka-ui": "^2.10.5",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.92",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.8",
    "@types/three": "^0.186.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12"
  }
}
